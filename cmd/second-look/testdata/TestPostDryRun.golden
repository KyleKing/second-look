graphql query($owner:String!,$name:String!,$number:Int!){
  repository(owner:$owner,name:$name){pullRequest(number:$number){id}}
}
{"query":"mutation($input:AddPullRequestReviewInput!){\n  addPullRequestReview(input:$input){pullRequestReview{id databaseId}}\n}","variables":{"input":{"commitOID":"6bc1218809a6faf83bc266c7a10b6b096f814a74","pullRequestId":"\u003cthe pull request's node id\u003e","threads":[{"path":"testdata/fixture/sample.go","line":19,"side":"RIGHT","body":"This returns os.ReadFile's error with no context, so the caller sees a bare `no such file or directory` and cannot tell which budget failed. Wrap it: `fmt.Errorf(\"reading %s: %w\", path, err)`."},{"path":"testdata/fixture/sample.go","line":28,"side":"RIGHT","startLine":25,"startSide":"RIGHT","body":"A line that does not parse is skipped silently, so a typo in the budget file reads as a smaller total rather than as an error. Return the failure instead of continuing past it."},{"path":"testdata/fixture/sample.go","line":33,"side":"RIGHT","body":"A budget that really does total zero is reported as empty. Check whether any entry parsed instead of checking the total."}]}}}

