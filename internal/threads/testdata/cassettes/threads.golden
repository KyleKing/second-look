[[interaction]]
stdout = "{\"data\":{\"repository\":{\"pullRequest\":{\"title\":\"test: Add a recording-target pull request for cassette tests\",\"body\":\"\",\"additions\":57,\"deletions\":0,\"author\":{\"login\":\"KyleKing\"},\"labels\":{\"nodes\":[]},\"comments\":{\"nodes\":[]},\"reviewThreads\":{\"nodes\":[{\"isResolved\":false,\"isOutdated\":false,\"path\":\"testdata/fixture/sample.go\",\"line\":19,\"diffSide\":\"RIGHT\",\"comments\":{\"nodes\":[{\"id\":\"PRRC_kwDOT-RSFs7odd7Z\",\"databaseId\":3900038873,\"body\":\"This returns os.ReadFile's error with no context, so the caller sees a bare `no such file or directory` and cannot tell which budget failed. Wrap it: `fmt.Errorf(\\\"reading %s: %w\\\", path, err)`.\",\"author\":{\"login\":\"KyleKing\"},\"reactionGroups\":[{\"content\":\"THUMBS_UP\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"THUMBS_DOWN\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"LAUGH\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"HOORAY\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"CONFUSED\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"HEART\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"ROCKET\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"EYES\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}}]},{\"id\":\"PRRC_kwDOT-RSFs7odhJO\",\"databaseId\":3900052046,\"body\":\"Agreed, and the wrap wants the path rather than the call: the caller already knows it called ReadBudget.\",\"author\":{\"login\":\"KyleKing\"},\"reactionGroups\":[{\"content\":\"THUMBS_UP\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"THUMBS_DOWN\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"LAUGH\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"HOORAY\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"CONFUSED\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"HEART\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"ROCKET\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"EYES\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}}]}]}},{\"isResolved\":false,\"isOutdated\":false,\"path\":\"testdata/fixture/sample.go\",\"line\":28,\"diffSide\":\"RIGHT\",\"comments\":{\"nodes\":[{\"id\":\"PRRC_kwDOT-RSFs7odd7b\",\"databaseId\":3900038875,\"body\":\"A line that does not parse is skipped silently, so a typo in the budget file reads as a smaller total rather than as an error. Return the failure instead of continuing past it.\",\"author\":{\"login\":\"KyleKing\"},\"reactionGroups\":[{\"content\":\"THUMBS_UP\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"THUMBS_DOWN\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"LAUGH\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"HOORAY\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"CONFUSED\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"HEART\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"ROCKET\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"EYES\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}}]}]}},{\"isResolved\":true,\"isOutdated\":false,\"path\":\"testdata/fixture/sample.go\",\"line\":33,\"diffSide\":\"RIGHT\",\"comments\":{\"nodes\":[{\"id\":\"PRRC_kwDOT-RSFs7odd7g\",\"databaseId\":3900038880,\"body\":\"A budget that really does total zero is reported as empty. Check whether any entry parsed instead of checking the total.\",\"author\":{\"login\":\"KyleKing\"},\"reactionGroups\":[{\"content\":\"THUMBS_UP\",\"viewerHasReacted\":true,\"reactors\":{\"totalCount\":1}},{\"content\":\"THUMBS_DOWN\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"LAUGH\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"HOORAY\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"CONFUSED\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"HEART\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"ROCKET\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}},{\"content\":\"EYES\",\"viewerHasReacted\":false,\"reactors\":{\"totalCount\":0}}]}]}}]}}}}}"
args = ['api', 'graphql', '-F', 'owner=KyleKing', '-F', 'repo=second-look', '-F', 'number=2', '-f', "query=query($owner:String!,$repo:String!,$number:Int!){\n  repository(owner:$owner,name:$repo){\n    pullRequest(number:$number){\n      title\n      body\n      additions\n      deletions\n      author{login}\n      labels(first:20){nodes{name}}\n      comments(last:20){nodes{\n        id databaseId body author{login}\n        reactionGroups{content viewerHasReacted reactors{totalCount}}\n      }}\n      reviewThreads(first:100){\n        nodes{\n          isResolved\n          isOutdated\n          path\n          line\n          diffSide\n          comments(first:50){nodes{\n            id databaseId body author{login}\n            reactionGroups{content viewerHasReacted reactors{totalCount}}\n          }}\n        }\n      }\n    }\n  }\n}"]
exit = 0
