[[interaction]]
args = ['api', 'graphql', '-F', 'owner=KyleKing', '-F', 'repo=second-look', '-F', 'number=2', '-f', "query=query($owner:String!,$repo:String!,$number:Int!){\n  repository(owner:$owner,name:$repo){\n    pullRequest(number:$number){\n      reviewThreads(first:100){\n        nodes{\n          isResolved\n          isOutdated\n          path\n          line\n          diffSide\n          comments(first:50){nodes{databaseId body author{login}}}\n        }\n      }\n    }\n  }\n}"]
stdout = "{\"data\":{\"repository\":{\"pullRequest\":{\"reviewThreads\":{\"nodes\":[{\"isResolved\":false,\"isOutdated\":false,\"path\":\"testdata/fixture/sample.go\",\"line\":19,\"diffSide\":\"RIGHT\",\"comments\":{\"nodes\":[{\"databaseId\":3900038873,\"body\":\"This returns os.ReadFile's error with no context, so the caller sees a bare `no such file or directory` and cannot tell which budget failed. Wrap it: `fmt.Errorf(\\\"reading %s: %w\\\", path, err)`.\",\"author\":{\"login\":\"KyleKing\"}},{\"databaseId\":3900052046,\"body\":\"Agreed, and the wrap wants the path rather than the call: the caller already knows it called ReadBudget.\",\"author\":{\"login\":\"KyleKing\"}}]}},{\"isResolved\":false,\"isOutdated\":false,\"path\":\"testdata/fixture/sample.go\",\"line\":28,\"diffSide\":\"RIGHT\",\"comments\":{\"nodes\":[{\"databaseId\":3900038875,\"body\":\"A line that does not parse is skipped silently, so a typo in the budget file reads as a smaller total rather than as an error. Return the failure instead of continuing past it.\",\"author\":{\"login\":\"KyleKing\"}}]}},{\"isResolved\":false,\"isOutdated\":false,\"path\":\"testdata/fixture/sample.go\",\"line\":33,\"diffSide\":\"RIGHT\",\"comments\":{\"nodes\":[{\"databaseId\":3900038880,\"body\":\"A budget that really does total zero is reported as empty. Check whether any entry parsed instead of checking the total.\",\"author\":{\"login\":\"KyleKing\"}}]}}]}}}}}"
exit = 0
