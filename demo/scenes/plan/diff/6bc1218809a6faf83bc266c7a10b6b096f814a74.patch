diff --git a/internal/cache/key_test.go b/internal/cache/key_test.go
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/internal/cache/key_test.go
@@ -0,0 +1,15 @@
+package cache_test
+
+import (
+	"testing"
+
+	"example.com/app/internal/cache"
+)
+
+func TestAPushIsAMiss(t *testing.T) {
+	c := cache.New()
+	c.Put(cache.KeyFor("o/r", "aaa"), nil)
+	if _, ok := c.Get(cache.KeyFor("o/r", "bbb")); ok {
+		t.Fatal("a new head read the old diff")
+	}
+}
