+package fixture
+
+import "strings"
+
+// splitLines is every non-empty line of the file, trimmed.
+func splitLines(raw string) []string {
+	var out []string
+
+	for _, line := range strings.Split(raw, "\n") {
+		if trimmed := strings.TrimSpace(line); trimmed != "" {
+			out = append(out, trimmed)
+		}
+	}
+
+	return out
+}
