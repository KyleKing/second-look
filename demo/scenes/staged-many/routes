# The pull request states this scene draws on its rows. A chunk of staged
# reviews is one query, so each of these four holds a single alias. Narrower
# routes go first, so each number answers its own file before the fixture's
# default does.
api graphql -F p0=117           merged-state.json
api graphql -F p0=118           approved-state.json
api graphql -F p0=130           closed-state.json
api graphql -F p0=140           closed-state.json
